# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Admin (seeded into DB on first run — change later from Admin → Password / Profile)
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_NAME=Turf Admin
ADMIN_EMAIL=you@example.com
ADMIN_MOBILE=9876543210

# Database — local file for development (works offline)
# For Vercel: create a free Turso DB and set these:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
DATABASE_URL=file:./data/local.db

# Venue (also editable via admin / stored in DB after init)
VENUE_NAME=GreenField Turf
VENUE_ADDRESS=123 Sports Complex, Your City
VENUE_PHONE=+919876543210
VENUE_MAPS_URL=https://maps.google.com/?q=GreenField+Turf
VENUE_OPEN_HOUR=6
VENUE_CLOSE_HOUR=22
WEEKDAY_PRICE=800
WEEKEND_PRICE=1000

# Email — Resend API (free tier, no Google Cloud)
# Sign up at https://resend.com → API Keys
# Until you verify a domain, use: Turf Booking <onboarding@resend.dev>
# (onboarding@resend.dev can only send to your Resend account email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Turf Booking <onboarding@resend.dev>"

# Web Push (Chrome admin alerts) — auto-generated if omitted
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@gmail.com

# Twilio — SMS + WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to false to skip customer SMS/WhatsApp (emails still send when Resend is set)
NOTIFY_ENABLED=false
